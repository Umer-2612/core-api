# Documentation only, not something to copy to .env. Real values live in
# Infisical (see README.md): `infisical login`, `infisical init`, then every
# script runs as `infisical run --env dev -- <command>` (already wired into
# package.json). This file exists so you know what variables are expected.

NODE_ENV=development
PORT=4000

SECRET_KEY=change-me-to-a-long-random-string
JWT_EXPIRES_IN_SECONDS=43200

LOG_LEVEL=info

CREDENTIALS=true
CORS_ORIGINS=http://localhost:3000

# Postgres (docker-compose exposes this on localhost:5432 by default)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/core_api?schema=public

FRONTEND_URL=http://localhost:3000
INVITATION_EXPIRY_HOURS=48

# SMTP is optional in development: unset means invitation links are logged to
# the console instead of emailed.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Interview Platform <no-reply@localhost>

# One-time super admin seed (needed only for `npm run seed:admin`)
SUPER_ADMIN_EMAIL=admin@example.com
SUPER_ADMIN_PASSWORD=changeme123
SUPER_ADMIN_NAME=Super Admin
SUPER_ADMIN_COMPANY_NAME=Interview Platform
SUPER_ADMIN_COMPANY_SLUG=interview-platform

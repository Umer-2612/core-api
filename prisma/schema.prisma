generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  super_admin
  hiring_manager
}

enum UserStatus {
  pending_verification
  active
  inactive
}

enum InterviewSessionStatus {
  scheduled
  completed
  cancelled
}

enum InterviewRoundType {
  dsa
  vscode
  technical_ai
}

enum InterviewRoundStatus {
  pending
  completed
}

enum QuestionDifficulty {
  easy
  medium
  hard
}

model Company {
  id         String   @id @default(uuid())
  name       String   @unique
  created_at DateTime @default(now())

  users User[]
  jobs  Job[]

  @@map("companies")
}

model User {
  id            String     @id @default(uuid())
  company_id    String
  full_name     String
  email         String     @unique
  password_hash String
  role          UserRole
  status        UserStatus @default(active)
  invited_by    String?
  created_at    DateTime   @default(now())

  company                    Company            @relation(fields: [company_id], references: [id], onDelete: Cascade)
  inviter                    User?              @relation("UserInvitedBy", fields: [invited_by], references: [id], onDelete: SetNull)
  invitees                   User[]             @relation("UserInvitedBy")
  created_jobs               Job[]              @relation("JobCreatedBy")
  created_candidates         Candidate[]        @relation("CandidateCreatedBy")
  created_interview_sessions InterviewSession[] @relation("InterviewSessionCreatedBy")

  @@index([company_id])
  @@map("users")
}

model Job {
  id          String   @id @default(uuid())
  company_id  String
  title       String
  description String
  created_by  String
  created_at  DateTime @default(now())

  company            Company            @relation(fields: [company_id], references: [id], onDelete: Cascade)
  creator            User               @relation("JobCreatedBy", fields: [created_by], references: [id], onDelete: Cascade)
  candidates         Candidate[]
  interview_sessions InterviewSession[]

  @@index([company_id])
  @@map("jobs")
}

model Candidate {
  id               String   @id @default(uuid())
  job_id           String
  full_name        String
  email            String?
  resume_file_name String
  resume_key       String
  created_by       String
  created_at       DateTime @default(now())

  job                Job                @relation(fields: [job_id], references: [id], onDelete: Cascade)
  creator            User               @relation("CandidateCreatedBy", fields: [created_by], references: [id], onDelete: Cascade)
  profile            CandidateProfile?
  interview_sessions InterviewSession[]

  @@index([job_id])
  @@map("candidates")
}

/// A scheduled interview for one candidate, for one job. Always has exactly
/// three InterviewRound rows (dsa, vscode, technical_ai) created alongside it,
/// only scheduling exists so far, not the rounds themselves being run.
model InterviewSession {
  id           String                 @id @default(uuid())
  job_id       String
  candidate_id String                 @unique
  /// The one link a candidate uses for the whole portal (all three rounds),
  /// no login: `/interview/:access_token` on web-frontend. Opaque, unguessable,
  /// generated once at scheduling time, never rotated.
  access_token String                 @unique @default(uuid())
  scheduled_at DateTime
  status       InterviewSessionStatus @default(scheduled)
  created_by   String
  created_at   DateTime               @default(now())

  job       Job              @relation(fields: [job_id], references: [id], onDelete: Cascade)
  candidate Candidate        @relation(fields: [candidate_id], references: [id], onDelete: Cascade)
  creator   User             @relation("InterviewSessionCreatedBy", fields: [created_by], references: [id], onDelete: Cascade)
  rounds    InterviewRound[]

  @@index([job_id])
  @@map("interview_sessions")
}

model InterviewRound {
  id          String               @id @default(uuid())
  session_id  String
  round_type  InterviewRoundType
  sequence    Int
  status      InterviewRoundStatus @default(pending)
  /// Only set for a `dsa` round: the questions assigned the first time the
  /// candidate opens it (randomly picked from the `Question` pool, then
  /// fixed for the rest of the round). Plain array of Question ids, not a
  /// real FK, the pool is small and centrally managed, a join table would
  /// be pure ceremony at this size.
  question_ids String[]            @default([])
  /// Only set once the candidate clicks "Start": the round's 60-minute
  /// timer counts down from here, not from when the link was opened.
  started_at   DateTime?
  /// Keyed by question id: `{ [question_id]: { code, language,
  /// test_results: { passed, total }, submitted_at } }`. No auto-grading
  /// beyond the test-case pass/fail count, a hiring manager reads the code.
  submissions  Json?
  created_at   DateTime             @default(now())

  session InterviewSession @relation(fields: [session_id], references: [id], onDelete: Cascade)

  @@index([session_id])
  @@map("interview_rounds")
}

/// A DSA question a candidate can be assigned during their `dsa` round.
/// Global pool for now, no per-job/per-hiring-manager authoring yet.
model Question {
  id           String             @id @default(uuid())
  title        String
  prompt       String
  difficulty   QuestionDifficulty @default(medium)
  /// Topic tags, e.g. ["arrays", "two-pointers"]. Not company tags, this
  /// platform doesn't do company-specific question sets.
  tags         String[]           @default([])
  /// Starter code per language id, e.g. `{ "javascript": "...", "python": "..." }`.
  starter_code Json
  /// `{ input, expected_output, locked }[]`. The first (unlocked) ones are
  /// shown to the candidate as worked examples; locked ones are graded but
  /// never shown, same as a typical online judge.
  test_cases   Json
  created_at   DateTime           @default(now())

  @@map("questions")
}

/// What the resume extractor pulled out of the PDF text, beyond the name and
/// email already on Candidate. One row per candidate, created at upload time.
model CandidateProfile {
  id           String   @id @default(uuid())
  candidate_id String   @unique
  phone        String?
  summary      String?
  skills       Json
  experience   Json
  education    Json
  sections     Json
  links        Json
  created_at   DateTime @default(now())

  candidate Candidate @relation(fields: [candidate_id], references: [id], onDelete: Cascade)

  @@map("candidate_profiles")
}

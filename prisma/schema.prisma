generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  super_admin
  hiring_manager
}

enum UserStatus {
  pending_verification
  active
  inactive
}

model Company {
  id         String   @id @default(uuid())
  name       String   @unique
  created_at DateTime @default(now())

  users User[]

  @@map("companies")
}

model User {
  id            String     @id @default(uuid())
  company_id    String
  full_name     String
  email         String     @unique
  password_hash String
  role          UserRole
  status        UserStatus @default(active)
  invited_by    String?
  created_at    DateTime   @default(now())

  company  Company @relation(fields: [company_id], references: [id], onDelete: Cascade)
  inviter  User?   @relation("UserInvitedBy", fields: [invited_by], references: [id], onDelete: SetNull)
  invitees User[]  @relation("UserInvitedBy")

  @@index([company_id])
  @@map("users")
}

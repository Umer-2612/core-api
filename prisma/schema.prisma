generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  super_admin
  hiring_manager
}

enum UserStatus {
  pending_verification
  active
  inactive
}

enum InterviewSessionStatus {
  scheduled
  completed
  cancelled
}

enum InterviewRoundType {
  dsa
  vscode
  technical_ai
}

enum InterviewRoundStatus {
  pending
  completed
}

model Company {
  id         String   @id @default(uuid())
  name       String   @unique
  created_at DateTime @default(now())

  users User[]
  jobs  Job[]

  @@map("companies")
}

model User {
  id            String     @id @default(uuid())
  company_id    String
  full_name     String
  email         String     @unique
  password_hash String
  role          UserRole
  status        UserStatus @default(active)
  invited_by    String?
  created_at    DateTime   @default(now())

  company                    Company            @relation(fields: [company_id], references: [id], onDelete: Cascade)
  inviter                    User?              @relation("UserInvitedBy", fields: [invited_by], references: [id], onDelete: SetNull)
  invitees                   User[]             @relation("UserInvitedBy")
  created_jobs               Job[]              @relation("JobCreatedBy")
  created_candidates         Candidate[]        @relation("CandidateCreatedBy")
  created_interview_sessions InterviewSession[] @relation("InterviewSessionCreatedBy")

  @@index([company_id])
  @@map("users")
}

model Job {
  id          String   @id @default(uuid())
  company_id  String
  title       String
  description String
  created_by  String
  created_at  DateTime @default(now())

  company            Company            @relation(fields: [company_id], references: [id], onDelete: Cascade)
  creator            User               @relation("JobCreatedBy", fields: [created_by], references: [id], onDelete: Cascade)
  candidates         Candidate[]
  interview_sessions InterviewSession[]

  @@index([company_id])
  @@map("jobs")
}

model Candidate {
  id               String   @id @default(uuid())
  job_id           String
  full_name        String
  email            String?
  resume_file_name String
  resume_key       String
  created_by       String
  created_at       DateTime @default(now())

  job                Job                @relation(fields: [job_id], references: [id], onDelete: Cascade)
  creator            User               @relation("CandidateCreatedBy", fields: [created_by], references: [id], onDelete: Cascade)
  profile            CandidateProfile?
  interview_sessions InterviewSession[]

  @@index([job_id])
  @@map("candidates")
}

/// A scheduled interview for one candidate, for one job. Always has exactly
/// three InterviewRound rows (dsa, vscode, technical_ai) created alongside it,
/// only scheduling exists so far, not the rounds themselves being run.
model InterviewSession {
  id           String                 @id @default(uuid())
  job_id       String
  candidate_id String                 @unique
  scheduled_at DateTime
  status       InterviewSessionStatus @default(scheduled)
  created_by   String
  created_at   DateTime               @default(now())

  job       Job              @relation(fields: [job_id], references: [id], onDelete: Cascade)
  candidate Candidate        @relation(fields: [candidate_id], references: [id], onDelete: Cascade)
  creator   User             @relation("InterviewSessionCreatedBy", fields: [created_by], references: [id], onDelete: Cascade)
  rounds    InterviewRound[]

  @@index([job_id])
  @@map("interview_sessions")
}

model InterviewRound {
  id         String               @id @default(uuid())
  session_id String
  round_type InterviewRoundType
  sequence   Int
  status     InterviewRoundStatus @default(pending)
  created_at DateTime             @default(now())

  session InterviewSession @relation(fields: [session_id], references: [id], onDelete: Cascade)

  @@index([session_id])
  @@map("interview_rounds")
}

/// What the resume extractor pulled out of the PDF text, beyond the name and
/// email already on Candidate. One row per candidate, created at upload time.
model CandidateProfile {
  id           String   @id @default(uuid())
  candidate_id String   @unique
  phone        String?
  summary      String?
  skills       Json
  experience   Json
  sections     Json
  created_at   DateTime @default(now())

  candidate Candidate @relation(fields: [candidate_id], references: [id], onDelete: Cascade)

  @@map("candidate_profiles")
}
